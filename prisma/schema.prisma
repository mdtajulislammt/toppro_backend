//    ############################# Currency Settings ##Start## ####################################################################
// ###############################################################################################################################

enum DecimalFormat {
  NO_DECIMAL // 1
  ONE_DECIMAL // 1.0
  TWO_DECIMAL // 1.00
  THREE_DECIMAL // 1.000
  FOUR_DECIMAL // 1.0000
}

enum SeparatorType {
  DOT // .
  COMMA // ,
}

enum CurrencySymbolPosition {
  PRE // $10.000,0
  POST // 10.000,0$
}

enum CurrencySymbolSpace {
  WITH_SPACE // $ 10.000,0
  WITHOUT_SPACE // $10.000,0
}

enum CurrencySymbolAndName {
  WITH_SYMBOL // $10.000,0
  WITH_NAME // 10.000,0 USD
}

model CurrencySettings {
  id                       String                 @id @default(cuid())
  created_at               DateTime               @default(now())
  updated_at               DateTime               @default(now())
  deleted_at               DateTime?
  decimal_format           DecimalFormat          @default(ONE_DECIMAL)
  decimal_separator        SeparatorType          @default(DOT)
  thousands_separator      SeparatorType          @default(COMMA)
  float_number             SeparatorType          @default(COMMA)
  currency_symbol_position CurrencySymbolPosition @default(PRE)
  currency_symbol_space    CurrencySymbolSpace    @default(WITHOUT_SPACE)
  currency_symbol_and_name CurrencySymbolAndName  @default(WITH_SYMBOL)
  default_currency         String                 @default("USD")
  owner_id                 String?
  workspace_id             String?
  owner                    User?                  @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  workspace                Workspace?             @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@map("currency_settings")
}

model ControllerSettings {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  owner_id String?
  super_id String?

  logo_dark    String?
  logo_light   String?
  logo_favicon String?

  title_text  String?
  footer_text String?

  customer_prefix String?
  vendor_prefix   String?

  user User[]

  @@map("controller_settings")
}
