model CompanySettings {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  // Company Information
  company_name                String?
  company_registration_number String?

  // Address Information
  address  String?
  city     String?
  state    String?
  country  String?
  zip_code String?

  // Contact Information
  telephone       String?
  email_from_name String?
  system_email    String?

  // Tax Information
