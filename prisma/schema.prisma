model Revenue {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  date        DateTime
  amount      Float?
  reference   String?
  description String?
  files       String? // Can store file paths or JSON string

  // Foreign Keys
  bank_account_id     String? // BankAccount id
  customer_id         String? // Customer id
  invoice_category_id String? // InvoiceCategory id

  user_id      String?
  workspace_id String?
  owner_id     String?

