enum CouponType {
  Percentage
  Flat
}

model Coupon {
  id           String     @id @default(cuid())
  name         String
  code         String     @unique
  type         CouponType
  discount     Float // Amount or percentage based on type
  minimumSpend Float? // Optional minimum spend requirement
  maximumSpend Float? // Optional maximum spend limit
  usageLimit   Int? // Total number of times this coupon can be used
  usagePerUser Int? // How many times a single user can use this coupon
  usedCount    Int        @default(0) // Track how many times the coupon has been used
  startDate    DateTime? // When the coupon becomes valid
  expiryDate   DateTime?
  isActive     Boolean    @default(true)
  description  String? // Description of the coupon
  applicableTo String[] // Array of plan types this coupon can be applied to (e.g., ["basic", "combo"])
  lastUsedAt   DateTime? // Track when the coupon was last used
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relationships (if needed)
  owner_id String
  owner    User   @relation(fields: [owner_id], references: [id], onDelete: Cascade)

  // Relations with plans
  basicPackage_id String?
  basicPackage    BasicPackage? @relation(fields: [basicPackage_id], references: [id])
  comboPlans      ComboPlan[]

  @@index([owner_id])
  @@index([code])
  @@map("coupons")
}

