model ModulePrice {
  id         String      @id @default(cuid())
  name       String
  priceMonth Int
  priceYear  Int
  logo       String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  comboPlans ComboPlan[]
}

model BasicPackage {
  id                       String    @id @default(cuid())
  monthlyBasicPrice        Int // 55 USD
  monthlyPricePerUser      Int // 5 USD
  monthlyPricePerWorkspace Int // 10 USD
  yearlyBasicPrice         Int // 500 USD
  yearlyPricePerUser       Int // 20 USD
  yearlyPricePerWorkspace  Int // 30 USD
  createdAt                DateTime  @default(now())
  type                     String    @default("basic")
  updatedAt                DateTime  @updatedAt
  coupons                  Coupon[]
  payments                 Payment[]
}

enum PlanType {
  Paid
  Free
}

model ComboPlan {
  id                 String        @id @default(cuid())
  name               String
  type               String        @default("combo")
  planType           PlanType
  numberOfUsers      Int
  numberOfWorkspaces Int
  pricePerMonth      Int
  pricePerYear       Int
  trialEnabled       Boolean       @default(false)
  trialDays          Int?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  modules            ModulePrice[]
  isEnabled          Boolean       @default(true)
  coupons            Coupon[] // Relation to applicable coupons
  payments           Payment[]

  @@map("combo_plans")
}

model Payment {
  id                    String        @id @default(cuid())
  userId                String
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  email                 String
  monthly               Boolean       @default(false)
  yearly                Boolean       @default(false)
  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @default("USD")
  discountAmount        Decimal?      @db.Decimal(10, 2)
  couponCode            String?
  finalAmount           Decimal       @db.Decimal(10, 2)
  stripePaymentIntentId String?       @unique
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  stripeInvoiceId       String?
  stripeChargeId        String?
  paymentStatus         String        @default("pending")
  paymentMethod         String?
  last4                 String?
  cardBrand             String?
  refundAmount          Decimal?      @db.Decimal(10, 2)
  refundReason          String?
  refundedAt            DateTime?
  paymentDate           DateTime      @default(now())
  expirationDate        DateTime
  basicPackageId        String?
  basicPackage          BasicPackage? @relation(fields: [basicPackageId], references: [id])
  comboPlanId           String?
  comboPlan             ComboPlan?    @relation(fields: [comboPlanId], references: [id])
  description           String?
  metadata              Json?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([stripePaymentIntentId])
  @@index([stripeCustomerId])
  @@index([paymentStatus])
  @@index([paymentDate])
  @@map("payments")
}

// Dynamic Stripe Subscription Management
model UserSubscription {
  id                     String   @id @default(cuid())
  user_id                String
  user                   User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  plan_type              String // "basic" or "combo"
  plan_id                String? // basic_package_id or combo_plan_id
  base_price             Int // Base plan price in cents
  user_count             Int      @default(0)
  workspace_count        Int      @default(0)
  Accounting_for_addons  Boolean  @default(false)
  Crm_for_addons         Boolean  @default(false)
  selected_modules       String[] // Array of module IDs
  coupon_code            String?
  stripe_subscription_id String   @unique
  stripe_price_id        String? // For fixed pricing
  stripe_customer_id     String
  status                 String   @default("active")
  billing_cycle          String // "monthly" or "yearly"
  current_period_start   DateTime
  current_period_end     DateTime
  next_billing_date      DateTime
  subtotal               Decimal  @db.Decimal(10, 2)
  discount_amount        Decimal? @db.Decimal(10, 2)
  total_amount           Decimal  @db.Decimal(10, 2)
  metadata               Json? // Store dynamic pricing details
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  @@index([user_id])
  @@index([stripe_subscription_id])
  @@index([status])
  @@map("user_subscriptions")
}

