//    ############################# Help Desk ##Start## #########################################################################
// ###############################################################################################################################

model HelpDeskCategory {
  id              String           @id @default(cuid())
  name            String           @db.VarChar(255)
  color           String           @db.VarChar(7) // Color in HEX format (e.g., #FF5733)
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt
  created_by      String
  user            User             @relation(fields: [created_by], references: [id])
  HelpDeskTickets HelpDeskTicket[] @relation("CategoryTickets")

  @@map("help_desk_categories")
}

model HelpDeskTicket {
  id            String   @id @default(cuid())
  customerId    String
  email         String
  categoryId    String
  status        T_status
  subject       String
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  descriptionId String?  @unique
  ticketId      String   @unique // Unique ticket ID
  notes         String?  @db.Text

  // description    TicketDescriptionWithAttachment? @relation(fields: [descriptionId], references: [id])
  descriptions TicketDescriptionWithAttachment[]
  category     HelpDeskCategory                  @relation("CategoryTickets", fields: [categoryId], references: [id], onDelete: Cascade)
  customer     User                              @relation("CustomerTickets", fields: [customerId], references: [id], onDelete: Cascade)
  creator      User                              @relation("CreatorTickets", fields: [createdBy], references: [id], onDelete: Cascade)

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("help_desk_tickets")
}

model TicketDescriptionWithAttachment {
  id          String                  @id @default(cuid())
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  description String // The text description of the ticket
  attachments DescriptionAttachment[] // Multiple attachments per description

  // ticket HelpDeskTicket?
  ticketId String
  ticket   HelpDeskTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  creatorId String
  creator   User   @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("ticket_descriptions_with_attachments")
}

model DescriptionAttachment {
  id            String                          @id @default(cuid())
  file_name     String
  file_url      String
  file_size     Int
  descriptionId String // Foreign key to TicketDescriptionWithAttachment
  description   TicketDescriptionWithAttachment @relation(fields: [descriptionId], references: [id], onDelete: Cascade)

  @@map("description_attachments")
}

enum T_status {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

