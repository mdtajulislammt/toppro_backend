generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id         String    @id @default(cuid())
  expires_at DateTime?
  user_id    String
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  type                String?
  provider            String?
  provider_account_id String?
  refresh_token       String?
  access_token        String?
  token_type          String?
  scope               String?
  id_token            String?
  session_state       String?

  @@unique([provider, provider_account_id])
  @@map("accounts")
}

enum PackageStatus {
  FREE
  PREMIUM_MONTHLY
  PREMIUM_YEARLY
}

model User {
  id             String        @id @default(cuid())
  created_at     DateTime      @default(now())
  updated_at     DateTime      @default(now())
  deleted_at     DateTime?
  status         Int?          @default(1) @db.SmallInt
  package_status PackageStatus @default(FREE)
  approved_at    DateTime?

  email      String? @unique
  username   String? @unique
  name       String? @db.VarChar(255)
  first_name String? @db.VarChar(255)
  last_name  String? @db.VarChar(255)
  password   String? @db.VarChar(255)
  avatar     String?

  super_id     String?
  owner_id     String?
  workspace_id String?

  workspace Workspace? @relation(fields: [workspace_id], references: [id])

  phone_number  String?
  country       String?
  state         String?
  city          String?
  address       String?
  zip_code      String?
  gender        String?
  date_of_birth DateTime? @db.Date

  billing_id String?
  type       UserType @default(USER) // SUPER ADMIN, OWNER, USER

  // Stripe subscription fields
  stripe_customer_id       String?   @unique
  stripe_subscription_id   String?   @unique
  stripe_payment_method_id String?
  subscription_status      String?   @default("inactive") // active, past_due, canceled, etc.
  current_period_start     DateTime?
  current_period_end       DateTime?
  cancel_at_period_end     Boolean   @default(false)

  email_verified_at     DateTime?
  is_two_factor_enabled Int?      @default(0)
  two_factor_secret     String?

  accounts                  Account[]
  creator_conversations     Conversation[] @relation("creator")
  participant_conversations Conversation[] @relation("participant")
  receiver_notifications    Notification[] @relation("receiver")
  sender_notifications      Notification[] @relation("sender")
  roles                     Role[]         @relation("UsersOnRoles")

  user_payment_methods     UserPaymentMethod[]
  user_settings            UserSetting[]
  ucodes                   Ucode[]
  permissions              Permission[]
  role_users               RoleUser[]
  payment_transactions     PaymentTransaction[]
  payments                 Payment[]
  services                 Service[]
  subscriptions            Subscription[]
  user_subscriptions       UserSubscription[]
  email_history_recipients EmailHistoryRecipient[]
  Pipeline                 Pipeline[]
  LeadStage                LeadStage[]
  DealStage                DealStage[]
  Label                    Label[]
  Source                   Source[]
  Customer                 Customer[]
  invoices                 Invoice[]
  Items                    Items[]
  leads                    Lead[]                  @relation("LeadUsers")
  owned_leads              Lead[]                  @relation("lead_owner")
  primary_user_leads       Lead[]
  owned_activities         Activity[]              @relation("activity_owner")
  assigned_calls           Call[]                  @relation("call_assignee")
  Purchase                 Purchase[]
  Bill                     Bill[]
  roleId                   String?
  PurchaseItems            PurchaseItems[]
  Discussion               Discussion[]
  LogTime                  LogTime[]
  InvoiceItem              InvoiceItem[]
  stock                    Stock[]
  controller_settings      ControllerSettings[]

  // Customer relation to HelpDeskTicket
  HelpDeskCategory       HelpDeskCategory[]
  HelpDeskTicketCustomer HelpDeskTicket[]   @relation("CustomerTickets")
  HelpDeskTicketCreator  HelpDeskTicket[]   @relation("CreatorTickets")

  BankAccount                     BankAccount[]
  Coupon                          Coupon[]
  ChartOfAccount                  ChartOfAccount[]
  CompanySettings                 CompanySettings[]
  CurrencySettings                CurrencySettings[]
  Revenue                         Revenue[]
  CreditNote                      CreditNote[]
  Transfer                        Transfer[]
  TicketDescriptionWithAttachment TicketDescriptionWithAttachment[]
  ReceiptSummary                  ReceiptSummary[]
  billItems                       BillItem[]
  expensePayments                 ExpensePayment[]
  debitNotes                      DebitNote[]

  @@map("users")
}

model Workspace {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now()) @updatedAt
  deleted_at DateTime?

  name        String
  code        String?
  description String?
  super_id    String?
  owner_id    String?

  status           Int?               @default(1) @db.SmallInt
  User             User[]
  Pipeline         Pipeline[]
  LeadStage        LeadStage[]
  DealStage        DealStage[]
  Label            Label[]
  Source           Source[]
  Customer         Customer[]
  Vendor           Vendor[]
  ItemCategory     ItemCategory[]
  InvoiceCategory  InvoiceCategory[]
  BillCategory     BillCategory[]
  Tax              Tax[]
  Unit             Unit[]
  Items            Items[]
  Invoice          Invoice[]
  Lead             Lead[]
  Activity         Activity[]
  Purchase         Purchase[]
  Bill             Bill[]
  ItemType         ItemType[]
  AccountType      AccountType[]
  PurchaseItems    PurchaseItems[]
  Discussion       Discussion[]
  LogTime          LogTime[]
  InvoiceItem      InvoiceItem[]
  stock            Stock[]
  HelpDeskTickets  HelpDeskTicket[]
  BankAccount      BankAccount[]
  CompanySettings  CompanySettings[]
  ChartOfAccount   ChartOfAccount[]
  CurrencySettings CurrencySettings[]
  Revenue          Revenue[]
  CreditNote       CreditNote[]
  Transfer         Transfer[]
  ReceiptSummary   ReceiptSummary[]
  billItems        BillItem[]
  expensePayments  ExpensePayment[]
  debitNotes       DebitNote[]

  @@map("workspaces")
}

enum UserType {
  SUPERADMIN
  OWNER
  USER
  CUSTOMER
  VENDOR
}

model Ucode {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
  status     Int?     @default(1) @db.SmallInt

  user_id String?
  user    User?   @relation(fields: [user_id], references: [id])

  token      String?
  email      String?
  expired_at DateTime?
  metadata   Json? // Store temporary registration data

  @@map("ucodes")
}

// Junction 

model Role {
  id          String    @id @default(cuid())
  created_at  DateTime  @default(now())
  updated_at  DateTime  @default(now())
  deleted_at  DateTime?
  description String?
  status      Int?      @default(1) @db.SmallInt
  title       String?   @default("user")
  name        String?   @default("user")

  owner_id     String?
  workspace_id String?

  // A role can have many users through RoleUser
  role_users RoleUser[] // pivot
  users      User[]     @relation("UsersOnRoles") // (optional virtual, see note below)

  permission_roles PermissionRole[]
  permissions      Permission[]     @relation("PermissionToRole")
  userId           String?

  @@map("roles")
}

model Permission {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  status      Int?    @default(1) @db.SmallInt
  title       String? @unique
  action      String?
  subject     String?
  conditions  String?
  fields      String?
  description String?

  owner_id     String?
  workspace_id String?
  user_id      String?

  user User? @relation(fields: [user_id], references: [id], onDelete: Cascade)

  permission_roles PermissionRole[]
  roles            Role[]           @relation("PermissionToRole") // Many-to-many relationship with Role

  @@map("permissions")
}

model PermissionRole {
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  permission_id String
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  role_id String
  role    Role   @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([permission_id, role_id])
  @@map("permission_roles")
}

model RoleUser {
  id         String   @id @default(cuid())
  role_id    String
  user_id    String
  created_at DateTime @default(now())

  role Role @relation(fields: [role_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // prevent duplicates: same user cannot be assigned the same role multiple times
  @@unique([role_id, user_id])
  @@map("role_users")
}

model LogTime {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  description String?
  date        DateTime?

  user_id      String?
  workspace_id String?
  owner_id     String?
  item_id      String?

  User      User?      @relation(fields: [user_id], references: [id])
  Workspace Workspace? @relation(fields: [workspace_id], references: [id])
  Items     Items?     @relation(fields: [item_id], references: [id])

  @@map("log_time") // This is where the table will be mapped
}

// Invoice Model
model Invoice {
  id                  String    @id @default(cuid())
  account_type_id     String?
  customer_id         String?
  billing_type_id     String?
  invoice_category_id String?
  invoice_number      String?
  issueAt             DateTime?
  dueAt               DateTime?
  item_category_id    String?
  subTotal            Float? //sub total
  totalDiscount       Float? //total discount
  totalTax            Float? //total tax
  totalPrice          Float? //amount
  paid                Float?    @default(0)
  due                 Float?    @default(0)
  status              Status    @default(DRAFT)

  owner_id     String?
  workspace_id String?
  user_id      String?
  stock_id     String?

  User      User?      @relation(fields: [user_id], references: [id])
  Workspace Workspace? @relation(fields: [workspace_id], references: [id])

  // Relations (assuming customer, billing type, and item category have models)
  Account_type     AccountType?     @relation(fields: [account_type_id], references: [id])
  Customer         Customer?        @relation(fields: [customer_id], references: [id])
  Billing_category BillCategory?    @relation(fields: [billing_type_id], references: [id])
  Item_category    ItemCategory?    @relation(fields: [item_category_id], references: [id])
  Invoice_category InvoiceCategory? @relation(fields: [invoice_category_id], references: [id])
  stock            Stock?           @relation(fields: [stock_id], references: [id])
  Item             Items[]
  InvoiceItem      InvoiceItem[]
  CreditNote       CreditNote?

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deleted_at     DateTime?
  ReceiptSummary ReceiptSummary[]

  @@map("invoices")
}

// InvoiceItem Model 
model InvoiceItem {
  id              String  @id @default(cuid())
  name            String?
  sku             String?
  image           String?
  invoice_id      String?
  item_type_id    String?
  item_id         String?
  itemCategory_id String?
  unit_id         String?
  quantity        Int?    @default(1)
  price           Float?  @default(0)
  discount        Float?  @default(0)
  tax_id          String?
  total           Float?  @default(0) //Amount
  description     String?
  customer_id     String?
  purchase_price  Float? // get item
  sale_price      Float? // get item 

  owner_id     String?
  workspace_id String?
  user_id      String?
  stock_id     String?

  User      User?      @relation(fields: [user_id], references: [id])
  Workspace Workspace? @relation(fields: [workspace_id], references: [id])

  // Relations (assuming itemType and tax have models)
  Item         Items?        @relation(fields: [item_id], references: [id])
  ItemType     ItemType?     @relation(fields: [item_type_id], references: [id])
  Tax          Tax?          @relation(fields: [tax_id], references: [id])
  ItemCategory ItemCategory? @relation(fields: [itemCategory_id], references: [id])
  Unit         Unit?         @relation(fields: [unit_id], references: [id])
  Customer     Customer?     @relation(fields: [customer_id], references: [id])
  Invoice      Invoice?      @relation(fields: [invoice_id], references: [id])
  stock        Stock?        @relation(fields: [stock_id], references: [id])

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deleted_at DateTime?

  @@map("invoice_items")
}

model Items {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  invoice_id      String?
  name            String?
  sku             String?
  tax_id          String?
  description     String?
  sale_price      Float?     @default(0)
  purchase_price  Float?     @default(0)
  unit_id         String?
  quantity        Int?       @default(1)
  image           String?
  vendor_id       String?
  itemCategory_id String?
  itemType_id     String?
  discount        Float?     @default(0)
  total           Float?     @default(0)
  owner_id        String?
  workspace_id    String?
  user_id         String?
  user            User?      @relation(fields: [user_id], references: [id])
  workspace       Workspace? @relation(fields: [workspace_id], references: [id])

  unit         Unit?         @relation(fields: [unit_id], references: [id])
  tax          Tax?          @relation(fields: [tax_id], references: [id])
  itemCategory ItemCategory? @relation(fields: [itemCategory_id], references: [id])
  vendor       Vendor[]
  itemType     ItemType?     @relation(fields: [itemType_id], references: [id])
  invoice      Invoice[]

  unit_price  Float? @default(0)
  total_price Float? @default(0)

  leads           Lead[]          @relation("LeadItems")
  Purchase        Purchase[]
  AccountType     AccountType?    @relation(fields: [account_type_id], references: [id])
  account_type_id String?
  PurchaseItems   PurchaseItems[]
  LogTime         LogTime[]
  InvoiceItem     InvoiceItem[]
  customer        Customer[]
  stock           Stock[]
  billItems       BillItem[]

  @@map("items")
}

model ReceiptSummary {
  id     String    @id @default(cuid())
  date   DateTime?
  amount Float

  bank_account_id String?
  bankAccount     BankAccount? @relation(fields: [bank_account_id], references: [id], onDelete: SetNull)

  invoice_id String?
  invoice    Invoice? @relation(fields: [invoice_id], references: [id], onDelete: SetNull)

  reference   String?
  description String?
  file        String?

  payment_type String  @default("manual")
  ordered      String?

  owner_id     String?
  user_id      String?
  workspace_id String?

  user      User?      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("receipt_summaries")
}

model Purchase {
  id            String    @id @default(cuid())
  created_at    DateTime  @default(now())
  updated_at    DateTime  @default(now())
  deleted_at    DateTime?
  purchase_date DateTime? // <-- use this as the "purchase date" you send from client
  status        Status?   @default(DRAFT)

  // MUST-HAVE header fields
  account_type_id String?
  vendor_id       String?
  billing_type_id String?
  category_id     String?
  purchase_no     String?
  subTotal        Float?  @default(0)
  tax_id          String?
  total           Float?  @default(0)
  paid            Float?  @default(0)
  due             Float?  @default(0)

  // Multitenancy / audit
  owner_id     String?
  workspace_id String?
  user_id      String?
  stock_id     String?

  // Relations (headers)
  stock       Stock?        @relation(fields: [stock_id], references: [id])
  AccountType AccountType?  @relation(fields: [account_type_id], references: [id])
  Vendor      Vendor?       @relation(fields: [vendor_id], references: [id])
  BillingType BillCategory? @relation(fields: [billing_type_id], references: [id])
  Category    ItemCategory? @relation(fields: [category_id], references: [id])
  user        User?         @relation(fields: [user_id], references: [id])
  workspace   Workspace?    @relation(fields: [workspace_id], references: [id])

  // One purchase -> many line items
  Bill          Bill[]
  Tax           Tax[]
  purchaseItems PurchaseItems[]
  Items         Items?          @relation(fields: [itemsId], references: [id])
  itemsId       String?

  @@map("purchases")
}

model PurchaseItems {
  id          String    @id @default(cuid())
  created_at  DateTime  @default(now())
  updated_at  DateTime  @default(now())
  deleted_at  DateTime?
  name        String?
  sku         String?
  description String?
  quantity    Int?      @default(1)
  image       String?
  discount    Float?    @default(0)
  total       Float?    @default(0)

  item Items[]

  invoice_id      String?
  tax_id          String?
  itemCategory_id String?
  sale_price      Float?  @default(0)
  purchase_price  Float?  @default(0)
  unit_id         String?
  vendor_id       String?
  itemType_id     String?
  owner_id        String?
  workspace_id    String?
  user_id         String?
  account_type_id String?
  purchase_id     String?
  stock_id        String?

  user      User?      @relation(fields: [user_id], references: [id])
  workspace Workspace? @relation(fields: [workspace_id], references: [id])

  unit         Unit?         @relation(fields: [unit_id], references: [id])
  tax          Tax?          @relation(fields: [tax_id], references: [id])
  itemCategory ItemCategory? @relation(fields: [itemCategory_id], references: [id])
  vendor       Vendor[]
  itemType     ItemType?     @relation(fields: [itemType_id], references: [id])

  unit_price  Float? @default(0)
  total_price Float? @default(0)

  leads        Lead[]
  Purchase     Purchase[]
  Account_type AccountType? @relation(fields: [account_type_id], references: [id])
  stock        Stock?       @relation(fields: [stock_id], references: [id])

  @@map("Purchase_items")
}

model Stock {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now()) @updatedAt
  deleted_at DateTime?

  product_name String
  sku          String
  quantity     Int
  image        String?

  item_id      String? @unique
  owner_id     String?
  workspace_id String?
  user_id      String?

  user      User?      @relation(fields: [user_id], references: [id])
  workspace Workspace? @relation(fields: [workspace_id], references: [id])

  Items Items? @relation(fields: [item_id], references: [id])

  purchaseItems PurchaseItems[]
  InvoiceItem   InvoiceItem[]
  invoice       Invoice[]

  Purchase Purchase[]

  @@map("stock")
}

model Bill {
  id             String    @id @default(cuid())
  created_at     DateTime  @default(now())
  updated_at     DateTime  @default(now()) @updatedAt
  deleted_at     DateTime?
  issued_at      DateTime?
  due_at         DateTime?
  category_id    String?
  bill_no        String?
  subTotal       Float     @default(0)
  tax_id         String?
  total          Float     @default(0)
  paid           Float     @default(0)
  due            Float     @default(0)
  status         Status    @default(DRAFT) // Use enum for status
  owner_id       String?
  workspace_id   String?
  user_id        String?
  accountType_id String?
  vendor_id      String?

  category    BillCategory? @relation(fields: [category_id], references: [id])
  user        User?         @relation(fields: [user_id], references: [id])
  vendor      Vendor?       @relation(fields: [vendor_id], references: [id])
  tax         Tax?          @relation(fields: [tax_id], references: [id])
  workspace   Workspace?    @relation(fields: [workspace_id], references: [id])
  AccountType AccountType?  @relation(fields: [accountType_id], references: [id])

  billItems       BillItem[]
  expensePayments ExpensePayment[]
  debitNotes      DebitNote[]
  purchase        Purchase?        @relation(fields: [purchaseId], references: [id])
  purchaseId      String?

  @@map("bills")
}

model BillItem {
  id          String  @id @default(cuid())
  item_id     String
  quantity    Float
  price       Float
  discount    Float   @default(0)
  total_price Float
  description String?
  tax_id      String?

  bill_id String
  bill    Bill   @relation(fields: [bill_id], references: [id])

  owner_id     String?
  user_id      String?
  workspace_id String?

  tax       Tax?       @relation(fields: [tax_id], references: [id])
  item      Items      @relation(fields: [item_id], references: [id]) // Ensure the correct reference to Item
  user      User?      @relation(fields: [user_id], references: [id])
  workspace Workspace? @relation(fields: [workspace_id], references: [id])

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  @@map("bill_items")
}

model ExpensePayment {
  id              String   @id @default(cuid())
  date            DateTime
  amount          Float
  bank_account_id String?
  vendor_id       String?
  description     String?
  category_id     String?
  reference       String?

  bill_id String?
  bill    Bill?   @relation(fields: [bill_id], references: [id])

  debit_notes DebitNote[]

  owner_id     String?
  user_id      String?
  workspace_id String?

  bank_account BankAccount?  @relation(fields: [bank_account_id], references: [id])
  vendor       Vendor?       @relation(fields: [vendor_id], references: [id])
  category     BillCategory? @relation(fields: [category_id], references: [id])
  user         User?         @relation(fields: [user_id], references: [id])
  workspace    Workspace?    @relation(fields: [workspace_id], references: [id])

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  @@map("expensePayments")
}

model DebitNote {
  id          String   @id @default(cuid())
  bill_id     String?
  vendor_id   String?
  date        DateTime
  amount      Float
  description String?
  category_id String?

  payment_id String?

  owner_id     String?
  user_id      String?
  workspace_id String?

  vendor         Vendor?         @relation(fields: [vendor_id], references: [id])
  user           User?           @relation(fields: [user_id], references: [id])
  workspace      Workspace?      @relation(fields: [workspace_id], references: [id])
  Bill           Bill?           @relation(fields: [bill_id], references: [id])
  ExpensePayment ExpensePayment? @relation(fields: [payment_id], references: [id])
  category       ItemCategory?   @relation(fields: [category_id], references: [id])

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  @@map("debit_notes")
}

// ###############################################################################################################################
//############################# Account Setup ##Start## #########################################################################
// ###############################################################################################################################

model BankAccount {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  bank_type       BankType
  holder_name     String?
  bank_name       String?
  account_number  String?
  opening_balance Float?   @default(0)
  contact_number  String?
  bank_branch     String?
  swift           String?
  bank_address    String?
  status          String?

  user_id             String?
  workspace_id        String?
  owner_id            String?
  chart_of_account_id String?

  user            User?            @relation(fields: [user_id], references: [id])
  workspace       Workspace?       @relation(fields: [workspace_id], references: [id])
  ChartOfAccount  ChartOfAccount?  @relation(fields: [chart_of_account_id], references: [id])
  Revenue         Revenue[]
  transfersFrom   Transfer[]       @relation("FromAccount")
  transfersTo     Transfer[]       @relation("ToAccount")
  ReceiptSummary  ReceiptSummary[]
  expensePayments ExpensePayment[]

  @@map("bank_accounts")
}

enum BankType {
  BANK
  WALLET
}

enum ParentAccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum ChildAccountType {
  CURRENT_ASSET
  INVENTORY_ASSET
  NON_CURRENT_ASSET
  CURRENT_LIABILITIES
  LONG_TERM_LIABILITIES
  SHARE_CAPITAL
  RETAINED_EARNINGS
  OWNERS_EQUITY
  SALES_REVENUE
  OTHER_REVENUE
  COST_OF_GOODS_SOLD
  PAYROLL_EXPENSES
  GENERAL_AND_ADMIN_EXPENSES
}

model ChartOfAccount {
  id                  String            @id @default(cuid())
  code                String            @unique
  name                String
  description         String?
  account_category    ParentAccountType
  parent_account_name String?
  child_account_type  ChildAccountType?
  balance             Float?            @default(0)
  status              String?           @default("ACTIVE")

  user_id      String?
  workspace_id String?
  owner_id     String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? @db.Timestamp(6)

  user      User?      @relation(fields: [user_id], references: [id])
  workspace Workspace? @relation(fields: [workspace_id], references: [id])

  bank_account BankAccount[]

  @@map("chart_of_accounts")
}

model Transfer {
  id           String   @id @default(cuid())
  from_type    BankType
  to_type      BankType
  from_account String
  to_account   String
  amount       Float
  date         DateTime @default(now())
  reference    String?
  description  String?

  // Common fields
  owner_id     String?
  workspace_id String?
  user_id      String?

  // Relations
  user      User?       @relation(fields: [user_id], references: [id])
  workspace Workspace?  @relation(fields: [workspace_id], references: [id])
  fromBank  BankAccount @relation("FromAccount", fields: [from_account], references: [id])
  toBank    BankAccount @relation("ToAccount", fields: [to_account], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("transfers")
}

